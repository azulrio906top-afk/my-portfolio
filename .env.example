# SQLite database used by Prisma.
# This path is portable and resolves relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Admin account used by the seed script.
ADMIN_NAME="Portfolio Admin"
ADMIN_EMAIL="admin@portfolio.dev"
ADMIN_PASSWORD="change-this-password"

# NextAuth/Auth.js secret. Use a long random value in production.
AUTH_SECRET="change-this-to-a-long-random-secret"

# OpenRouter API configuration.
# Keep your real key only in .env or your hosting provider's secret store.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Backward-compatible fallback for the existing project configuration.
# You can use either OPENROUTER_API_KEY or OPENAI_API_KEY.
OPENAI_API_KEY=""
OPENAI_MODEL=""
